# Directory rules apply at every depth, including fabric/ and neoforge/.
.gradle/
.gradle-user-home/
.offline-libs/
.idea/
.fleet/
.vscode/
.eclipse/
.settings/
.classpath
.project
build/
out/
run/
logs/
*.iml
*.ipr
*.iws
*.log
hs_err_pid*
replay_pid*
.forceblend-lease-*/
.team/

# Local compiler output and development tooling
bin/
*.class
*.hprof
.DS_Store
Thumbs.db

# Local environment configuration; keep shareable examples available.
.env
.env.*
!.env.example

# Private maintainer and agent files
AGENTS.md
CLAUDE.md
.agents/
.claude/
.codex/
.cursorrules
.cursor/
.aider*

# Local world backups (not source or test fixtures)
/backups/
/fabric/backups/
/neoforge/backups/
/paper/backups/
/bukkit-plugin/backups/

# Operator acceptance/settings are local; the packaged safe-default template remains tracked.
/forceblend-prestart.properties
/bukkit-plugin/forceblend-prestart.properties
/forceblend-settings-and-acceptance.properties
/bukkit-plugin/forceblend-settings-and-acceptance.properties

# Detailed internal documentation belongs in forceblend-team; public README and changelog stay here.
/docs/
/CONTRIBUTING.md
/CODE_OF_CONDUCT.md
/SECURITY.md
/common/README.md
/paper/README.md
