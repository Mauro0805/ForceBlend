{
  "schemaVersion": 1,
  "id": "forceblend",
  "version": "${version}",
  "name": "ForceBlend",
  "description": "Prepares existing Overworld chunks for Minecraft's native terrain blending after seed, generator, or chunk-layout changes.",
  "authors": [
    "mauro0805"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mauro0805.forceblend.client.ForceBlendClient"
    ]
  },
  "mixins": [
    {
      "config": "forceblend.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.12.12",
    "minecraft": [
      ">=1.18 <=1.21.11",
      ">=26.1 <=26.2"
    ],
    "java": ">=17"
  }
}
